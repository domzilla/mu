{
	"name": "mu",
	"version": "0.84.2-mu.1",
	"description": "mu - a minimal headless agent runtime/SDK trimmed from pi",
	"private": true,
	"type": "module",
	"license": "MIT",
	"piConfig": {
		"configDir": ".pi"
	},
	"piUpstream": {
		"version": "0.84.2"
	},
	"exports": {
		"./ai": {
			"types": "./dist/ai/index.d.ts",
			"import": "./dist/ai/index.js"
		},
		"./ai/oauth": {
			"types": "./dist/ai/oauth.d.ts",
			"import": "./dist/ai/oauth.js"
		},
		"./ai/bun-oauth": {
			"types": "./dist/ai/bun-oauth.d.ts",
			"import": "./dist/ai/bun-oauth.js"
		},
		"./ai/providers/anthropic": {
			"types": "./dist/ai/providers/anthropic.d.ts",
			"import": "./dist/ai/providers/anthropic.js"
		},
		"./ai/providers/openai-codex": {
			"types": "./dist/ai/providers/openai-codex.d.ts",
			"import": "./dist/ai/providers/openai-codex.js"
		},
		"./agent-core": {
			"types": "./dist/agent-core/index.d.ts",
			"import": "./dist/agent-core/index.js"
		},
		"./coding-agent": {
			"types": "./dist/coding-agent/index.d.ts",
			"import": "./dist/coding-agent/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "tsc -p tsconfig.json && node build/copy-assets.mjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.91.1",
		"@silvia-odwyer/photon-node": "0.3.4",
		"chalk": "5.6.2",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"ignore": "7.0.5",
		"minimatch": "10.2.5",
		"openai": "6.40.0",
		"partial-json": "0.1.7",
		"proper-lockfile": "4.1.2",
		"typebox": "1.3.7",
		"undici": "8.9.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/diff": "7.0.2",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
