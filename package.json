{
	"name": "mu",
	"version": "0.84.2-mu.1",
	"description": "Trimmed single-package fork of the Pi agent framework (pi-ai, pi-agent-core, pi-coding-agent)",
	"private": true,
	"type": "module",
	"license": "MIT",
	"piConfig": {
		"configDir": ".pi"
	},
	"piUpstream": {
		"name": "@earendil-works/pi-coding-agent",
		"version": "0.84.2"
	},
	"exports": {
		"./ai": {
			"types": "./dist/ai/index.d.ts",
			"import": "./dist/ai/index.js"
		},
		"./ai/oauth": {
			"types": "./dist/ai/oauth.d.ts",
			"import": "./dist/ai/oauth.js"
		},
		"./ai/bun-oauth": {
			"types": "./dist/ai/bun-oauth.d.ts",
			"import": "./dist/ai/bun-oauth.js"
		},
		"./ai/providers/anthropic": {
			"types": "./dist/ai/providers/anthropic.d.ts",
			"import": "./dist/ai/providers/anthropic.js"
		},
		"./ai/providers/openai-codex": {
			"types": "./dist/ai/providers/openai-codex.d.ts",
			"import": "./dist/ai/providers/openai-codex.js"
		},
		"./agent-core": {
			"types": "./dist/agent-core/index.d.ts",
			"import": "./dist/agent-core/index.js"
		},
		"./coding-agent": {
			"types": "./dist/coding-agent/index.d.ts",
			"import": "./dist/coding-agent/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "tsc -p tsconfig.json && node build/copy-assets.mjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.91.1",
		"@aws-sdk/client-bedrock-runtime": "3.1048.0",
		"@google/genai": "1.52.0",
		"@opentelemetry/api": "1.9.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"@smithy/node-http-handler": "4.7.3",
		"chalk": "5.6.2",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"get-east-asian-width": "1.6.0",
		"glob": "13.0.6",
		"grok-mermaid": "0.2.2",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"http-proxy-agent": "7.0.2",
		"https-proxy-agent": "7.0.6",
		"ignore": "7.0.5",
		"jiti": "2.7.0",
		"marked": "18.0.5",
		"minimatch": "10.2.5",
		"openai": "6.40.0",
		"partial-json": "0.1.7",
		"proper-lockfile": "4.1.2",
		"semver": "7.8.0",
		"typebox": "1.3.7",
		"undici": "8.9.0",
		"yaml": "2.9.0"
	},
	"optionalDependencies": {
		"@mariozechner/clipboard": "0.3.9"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/diff": "7.0.2",
		"@types/hosted-git-info": "3.0.5",
		"@types/ms": "2.1.0",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"overrides": {
		"protobufjs": "7.6.5",
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
